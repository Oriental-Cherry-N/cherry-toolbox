{
  "name": "connection-switcher",
  "productName": "Connection Switcher",
  "version": "1.0.0",
  "description": "A small Windows utility for safely enabling and disabling network adapters.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/build-contract.test.js test/connection-monitor.test.js test/network.test.js test/recovery.test.js test/settings.test.js",
    "verify": "npm run typecheck && npm test",
    "start": "npm run build && electron-forge start",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "clean": "node scripts/clean.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NzoSifou/connection-switcher.git"
  },
  "keywords": [
    "connection",
    "network",
    "adapter",
    "ethernet",
    "wifi",
    "windows"
  ],
  "author": "NzoSifou",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/NzoSifou/connection-switcher/issues"
  },
  "homepage": "https://github.com/NzoSifou/connection-switcher#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@types/node": "24.13.3",
    "electron": "43.2.0",
    "typescript": "7.0.2"
  }
}
