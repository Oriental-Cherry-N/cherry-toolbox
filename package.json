{
  "name": "cherry-toolbox",
  "productName": "Cherry Toolbox",
  "version": "0.1.0",
  "description": "A personal Windows toolbox, starting with safe network adapter switching.",
  "main": "dist/main/main.js",
  "scripts": {
    "postinstall": "node scripts/harden-build-dependencies.cjs",
    "prebuild": "node scripts/harden-build-dependencies.cjs",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-source.ps1",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "build:main": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-source.ps1 -Mode Main",
    "build:renderer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-source.ps1 -Mode Renderer",
    "typecheck": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-source.ps1 -Mode Check",
    "test": "npm run build && node --test test/*.test.js",
    "verify": "npm run typecheck && npm test",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-source.ps1 -Mode Launch",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "shortcut:source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-source-shortcut.ps1",
    "clean": "node scripts/clean.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oriental-Cherry-N/cherry-toolbox.git"
  },
  "keywords": [
    "toolbox",
    "windows",
    "connection",
    "network",
    "adapter",
    "ethernet",
    "wifi",
    "wechat",
    "automation"
  ],
  "author": "Cherry Toolbox contributors",
  "contributors": [
    "NzoSifou",
    "Oriental-Cherry-N"
  ],
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/Oriental-Cherry-N/cherry-toolbox/issues"
  },
  "homepage": "https://github.com/Oriental-Cherry-N/cherry-toolbox#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "fast-uri": "3.1.6",
    "@xmldom/xmldom": "0.9.12"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@types/node": "24.13.3",
    "electron": "43.2.0",
    "typescript": "7.0.2"
  }
}
