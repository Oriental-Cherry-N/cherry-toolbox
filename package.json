{
  "name": "cherry-toolbox",
  "productName": "Cherry Toolbox",
  "version": "0.1.0",
  "description": "A personal Windows toolbox, starting with safe network adapter switching.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run build && node --test test/build-contract.test.js test/connection-monitor.test.js test/network.test.js test/recovery.test.js test/settings.test.js",
    "verify": "npm run typecheck && npm test",
    "start": "npm run build && electron-forge start",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "clean": "node scripts/clean.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oriental-Cherry-N/cherry-toolbox.git"
  },
  "keywords": [
    "toolbox",
    "windows",
    "connection",
    "network",
    "adapter",
    "ethernet",
    "wifi"
  ],
  "author": "Cherry Toolbox contributors",
  "contributors": [
    "NzoSifou",
    "Oriental-Cherry-N"
  ],
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/Oriental-Cherry-N/cherry-toolbox/issues"
  },
  "homepage": "https://github.com/Oriental-Cherry-N/cherry-toolbox#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@types/node": "24.13.3",
    "electron": "43.2.0",
    "typescript": "7.0.2"
  }
}
